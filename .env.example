# Copiar este archivo como .env y completar los valores.
# El .env NO se sube a git: cada integrante tiene el suyo.

# Generar una con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=techos_valor_dev
DB_USER=techos_valor
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# prefer en local; require para Neon
DB_SSLMODE=prefer
